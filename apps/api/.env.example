# Production PDFs require a private Azure Blob container. Never use public Cloudinary PDFs.
PRIVATE_DOWNLOADS_ENABLED=false
AZURE_STORAGE_CONNECTION_STRING=
AZURE_PRIVATE_CONTAINER=devsangam-private
# Development only; store outside public web directories and do not commit PDFs.
PRIVATE_ASSET_DIR=.private-assets
# Set only after verifying the trusted Azure reverse-proxy hop count (0–3).
TRUST_PROXY_HOPS=0
