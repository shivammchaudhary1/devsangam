{
  "name": "devsangam",
  "version": "0.1.0",
  "description": "DevSangam is a devotional PWA for mantra practice, digital mala counting, practice history, insights, offline sessions, and reminders.",
  "private": true,
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bugs": {
    "url": "https://github.com/shivammchaudhary1/devsangam/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivammchaudhary1/devsangam.git"
  },
  "license": "MIT",
  "author": "Shivamm Chaudhary",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n WEB,API -c auto \"npm run dev -w @devsangam/web\" \"npm run dev -w @devsangam/api\"",
    "dev:web": "npm run dev -w @devsangam/web",
    "dev:api": "npm run dev -w @devsangam/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @devsangam/web && npm run lint -w @devsangam/api",
    "lint:fix": "npm run lint:fix -w @devsangam/web && npm run lint:fix -w @devsangam/api",
    "test": "npm run test -w @devsangam/api",
    "test:e2e": "tsx --tsconfig apps/api/tsconfig.json scripts/v2-e2e.mjs",
    "test:public": "node scripts/public-site-smoke.mjs",
    "test:ui": "node scripts/v2-ui-smoke.mjs",
    "test:offline": "node scripts/v1-offline-smoke.mjs",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "test:e2e:built": "npm run build -w @devsangam/api && node scripts/v2-e2e.mjs --compiled",
    "test:visual": "node scripts/migration-visual-smoke.mjs after --compare",
    "test:pwa": "node scripts/pwa-update-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.5",
    "pixelmatch": "^8.0.0"
  }
}
